# Copy to .env.local (and set the same keys in Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only shared secret (never prefix with NEXT_PUBLIC_). Used for:
#  - the sign-in throttle and upload/report rate-limit RPCs (they refuse calls without it)
#  - signing the age-gate and terms-acceptance cookies (HMAC-derived keys)
# Must equal private.app_config.auth_throttle_secret in the database.
# Generate one with:  openssl rand -hex 32
# Without it: sign-in throttle is off, uploads are disabled, age cookie is unsigned.
AUTH_THROTTLE_SECRET=

# Only for scripts/cleanup-orphan-media.mjs (run locally, never in the app or the browser):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
